    <!-- Onboarding -->
    <string name="onboarding_1_title">ঝকঝকে ছবি</string>
    <string name="onboarding_1_body">ছবি ৪x পর্যন্ত আপস্কেল করুন সরাসরি আপনার ফোনে - দ্রুত কমপ্যাক্ট নেটওয়ার্ক থেকে শুরু করে সম্পূর্ণ RealESRGAN_x4plus হাই-কোয়ালিটি মডেল পর্যন্ত, প্রতিটি ডিভাইসের জন্য গতি/গুণমানের বিকল্প আছে।</string>
    <string name="onboarding_2_title">১০০% অফলাইন</string>
    <string name="onboarding_2_body">সবকিছু আপনার ডিভাইসেই চলে। আপনার ছবি কখনোই ফোন ছেড়ে যায় না - অ্যাপটি ইন্টারনেট অনুমতি চায়ই না।</string>
    <string name="onboarding_3_title">বেছে নিন, উন্নত করুন, তুলনা করুন</string>
    <string name="onboarding_3_body">মডেল বেছে নিন, কমপ্রেসড ছবির জন্য ডিনয়েজ শক্তি ঠিক করুন, তারপর ড্র্যাগ করা যায় এমন আগে/পরে স্লাইডার দিয়ে ফলাফল তুলনা করুন। আপনার লাইব্রেরি প্রতিটি ফলাফল সংরক্ষণ করে।</string>

