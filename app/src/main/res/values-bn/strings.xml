    <!-- Onboarding -->
    <string name="onboarding_1_title">ঝকঝকে ছবি ও ভিডিও</string>
    <string name="onboarding_1_body">গতির জন্য তৈরি একটি কমপ্যাক্ট নিউরাল নেটওয়ার্ক দিয়ে আপনার ফোনেই ছবি ৪x পর্যন্ত আপস্কেল করুন এবং ভিডিও উন্নত করুন।</string>
    <string name="onboarding_2_title">১০০% অফলাইন</string>
    <string name="onboarding_2_body">সবকিছু আপনার ডিভাইসেই চলে। আপনার ছবি ও ভিডিও কখনোই ফোন ছেড়ে যায় না - অ্যাপটি ইন্টারনেট অনুমতি চায়ই না।</string>
    <string name="onboarding_3_title">বেছে নিন, উন্নত করুন, তুলনা করুন</string>
    <string name="onboarding_3_body">ছবি, অ্যানিমে বা নয়েজি ছবির জন্য মডেল বেছে নিন, তারপর ড্র্যাগ করা যায় এমন আগে/পরে স্লাইডার দিয়ে ফলাফল তুলনা করুন। আপনার লাইব্রেরি প্রতিটি ফলাফল সংরক্ষণ করে।</string>

