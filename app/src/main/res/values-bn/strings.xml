    <!-- WDN interpolation -->
    <string name="options_wdn_title">ডিনয়েজ শক্তি: %1$d%%</string>
    <string name="options_wdn_hint">ছবির মডেলটিকে তার ডিনয়েজ-প্রশিক্ষিত WDN জোড়ার সাথে মেশানো হয়। ০% সবচেয়ে বেশি টেক্সচার রাখে; বেশি মান বেশি নয়েজ দূর করে কিন্তু ছবি মসৃণ দেখায়।</string>

    <!-- HDR enhancement (per model) -->
    <string name="options_hdr_title">HDR</string>
    <string name="options_hdr_hint">আপস্কেলের আগে HDRNet মডেল (Zero-DCE++ কার্ভ) চালানো হয়: শ্যাডো তোলে, হাইলাইট ধ্বংস থেকে বাঁচায় ও HDR-ধাঁচের গভীরতা যোগ করে - ডিফল্টেই ছবি ন্যাচারাল থাকে। প্রতিটি মডেলের জন্য আলাদাভাবে মনে রাখা হয়।</string>
    <string name="options_hdr_strength">HDR শক্তি: %1$d%%</string>
    <string name="options_hdr_strength_hint">কম = বেশি ন্যাচারাল, বেশি = জোরালো HDR ইফেক্ট। যেকোনো মানেই ব্রাইটনেস স্বয়ংক্রিয়ভাবে নিয়ন্ত্রণে থাকে।</string>

