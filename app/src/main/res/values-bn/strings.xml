    <!-- About -->
    <string name="about_version">ভার্সন %1$s</string>
    <string name="about_offline">কোনো ইন্টারনেট অনুমতি নেই - সম্পূর্ণ অফলাইন</string>
    <string name="about_how_title">যেভাবে কাজ করে</string>
    <string name="about_how_body">Real-ESRGAN-এর সুপার-রেজোলিউশন নেটওয়ার্কগুলো Tencent-এর ncnn ইঞ্জিনের মাধ্যমে স্থানীয়ভাবে চলে, সম্ভব হলে ফোনের GPU ব্যবহার করে। কমপ্যাক্ট মডেলগুলো যেকোনো ডিভাইসে দ্রুত চলে, ঐচ্ছিক হাই-কোয়ালিটি মডেল (সম্পূর্ণ RealESRGAN_x4plus RRDBNet) বেশি আসল টেক্সচার ফিরিয়ে আনে, আর ডিনয়েজ স্লাইডার নয়েজি ছবির জন্য WDN-প্রশিক্ষিত ওয়েট মেশায়। বড় ছবি ওভারল্যাপিং টাইলে প্রসেস হয় যাতে মেমরি নিরাপদ থাকে।</string>
    <string name="about_credits_title">ওপেন-সোর্স কৃতজ্ঞতা</string>
    <string name="about_credits_ncnn">ইনফারেন্স: Tencent-এর ncnn (BSD 3-Clause) - https://github.com/Tencent/ncnn</string>
    <string name="about_credits_realesrgan">মডেল: Xinntao ও অন্যান্যদের Real-ESRGAN (BSD 3-Clause) - https://github.com/xinntao/Real-ESRGAN</string>
    <string name="about_credits_note">কিছু বান্ডেল করা মডেল তালিকাভুক্ত ব্যবহারের জন্য সবচেয়ে কাছের উপলব্ধ কমপ্যাক্ট ভ্যারিয়েন্ট এবং মডেল পিকারে স্পষ্টভাবে চিহ্নিত; পরে এগুলো উদ্দেশ্যে-প্রশিক্ষিত ওয়েট দিয়ে বদলানো যাবে।</string>
    <string name="about_privacy_title">গোপনীয়তা</string>
    <string name="about_privacy_body">অ্যাপটি আদৌ কোনো ইন্টারনেট অ্যাক্সেস চায় না। আপনি যা প্রসেস করেন তা স্বয়ংক্রিয়ভাবে আপলোড, লগ বা শেয়ার হয় না। লাইব্রেরি থেকে কোনো আইটেম মুছলে তার ফলাফল ফাইলও মুছে যায়।</string>
</resources>
