    <!-- Onboarding -->
    <string name="onboarding_1_title">Sharper photos</string>
    <string name="onboarding_1_body">Upscale images up to 4x right on your phone - from a fast compact network to the full RealESRGAN_x4plus high-quality model, there is a speed/quality option for every device.</string>
    <string name="onboarding_2_title">100% offline</string>
    <string name="onboarding_2_body">Everything runs on your device. Your photos never leave your phone - the app doesn\'t even request internet access.</string>
    <string name="onboarding_3_title">Pick, enhance, compare</string>
    <string name="onboarding_3_body">Choose a model, dial in denoise strength for compressed photos, then compare the result with a draggable before/after slider. Your library keeps every result.</string>

