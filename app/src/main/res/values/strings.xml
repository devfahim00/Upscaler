    <!-- About -->
    <string name="about_version">Version %1$s</string>
    <string name="about_offline">No internet permission - fully offline</string>
    <string name="about_how_title">How it works</string>
    <string name="about_how_body">A compact super-resolution network (the SRVGGNetCompact family used by Real-ESRGAN\'s fast models) runs locally through Tencent\'s ncnn inference engine, using the phone\'s GPU when possible. Large images are processed in overlapping tiles so memory stays safe, and videos are enhanced frame by frame while the audio is copied through untouched.</string>
    <string name="about_credits_title">Open-source credits</string>
    <string name="about_credits_ncnn">Inference: ncnn by Tencent (BSD 3-Clause) - https://github.com/Tencent/ncnn</string>
    <string name="about_credits_realesrgan">Models: Real-ESRGAN by Xinntao et al. (BSD 3-Clause) - https://github.com/xinntao/Real-ESRGAN</string>
    <string name="about_credits_note">Some bundled models are the closest publicly available compact variants for a listed use-case and are clearly flagged in the model picker; they can be swapped for purpose-trained weights later.</string>
    <string name="about_privacy_title">Privacy</string>
    <string name="about_privacy_body">The app declares no internet access at all. Nothing you process here is uploaded, logged or shared automatically. Deleting an item from the library also deletes its result file.</string>
