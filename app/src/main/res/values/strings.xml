    <!-- WDN interpolation -->
    <string name="options_wdn_title">Denoise strength: %1$d%%</string>
    <string name="options_wdn_hint">Blends the photo model with its denoise-trained WDN twin. 0% keeps the most texture; higher values remove more noise but look smoother.</string>

    <!-- HDR enhancement (per model) -->
    <string name="options_hdr_title">HDR</string>
    <string name="options_hdr_hint">Runs the HDRNet model (Zero-DCE++ curves) before upscaling: lifts shadows, protects highlights and adds HDR-style depth - tuned to stay natural by default. Remembered per model.</string>
    <string name="options_hdr_strength">HDR strength: %1$d%%</string>
    <string name="options_hdr_strength_hint">Lower = more natural, higher = a stronger HDR punch. Brightness is kept in check automatically either way.</string>

